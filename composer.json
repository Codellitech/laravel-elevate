{
    "name": "codellitech/laravel-elevate",
    "description": "Enterprise-grade autonomous Laravel modernization and upgrade platform.",
    "keywords": [
        "laravel",
        "upgrade",
        "modernization",
        "ai",
        "rector",
        "refactoring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Codelli Technologies",
            "email": "info@codellitech.in",
            "homepage": "https://codellitech.in",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0",
        "nikic/php-parser": "^5.0",
        "rector/rector": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/process": "^6.0|^7.0",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "laravel/prompts": "Required for the premium interactive CLI experience (^0.1)."
    },
    "autoload": {
        "psr-4": {
            "Codellitech\\Elevate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Codellitech\\Elevate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codellitech\\Elevate\\LaravelElevateServiceProvider"
            ],
            "aliases": {
                "Elevate": "Codellitech\\Elevate\\Facades\\Elevate"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
